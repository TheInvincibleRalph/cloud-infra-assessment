.DS_Store

# Terraform working data and state must never be committed.
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable and backend files can contain account-specific or sensitive values.
*.tfvars
*.tfvars.json
backend.hcl
!*.tfvars.example
!backend.hcl.example

# Credentials and private keys.
*.pem
*.key
.env

# Local Python artifacts from testing the demonstration application.
__pycache__/
*.py[cod]
